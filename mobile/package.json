{
  "name": "kanboard-mobile",
  "version": "1.0.0",
  "description": "Kanboard AlbrightLabs Mobile App - React Native",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "ios": "react-native run-ios",
