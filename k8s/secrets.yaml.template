# Template for secrets - DO NOT commit with real values
# Copy to secrets.yaml and fill in values, then apply:
# kubectl apply -f secrets.yaml
apiVersion: v1
kind: Secret
metadata:
  name: kanboard-secrets
  namespace: hr-project-tracking
type: Opaque
stringData:
  # Kanboard API token (get from Kanboard admin panel)
  api-token: "REPLACE_WITH_KANBOARD_API_TOKEN"
  # GitHub token for PR creation and TOC updates
  github-token: "REPLACE_WITH_GITHUB_TOKEN"
